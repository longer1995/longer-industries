# Copy to .env and fill in. Set these as Supabase Edge Function secrets:
#   supabase secrets set --env-file .env

# Supabase (service role — server-side only, never ship to the frontend)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Transcription
OPENAI_API_KEY=

# Extraction
ANTHROPIC_API_KEY=

# HubSpot (private app token)
HUBSPOT_TOKEN=

# Zoho CRM (OAuth refresh-token flow)
ZOHO_REFRESH_TOKEN=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_DC=com
